## Core
GEMINI_API_KEY=your-gemini-api-key-here
PORT=3001

## PostHog analytics (Phase 1 - client)
# https://app.posthog.com -> Project Settings -> API Keys
VITE_POSTHOG_KEY=phc_your_project_key_here
VITE_POSTHOG_HOST=https://us.i.posthog.com

## Phase 2 - Neon Postgres (persistence)
# https://neon.tech -> create project -> copy connection string
# Use the pooled connection string (ends with -pooler.)
NEON_DATABASE_URL=postgres://user:pass@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

## Phase 2 - Clerk auth (magic link)
# https://dashboard.clerk.com -> create app -> API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

## Phase 2 - encryption of idea text stored in DB
# Generate a fresh key with: openssl rand -base64 32
IDEA_ENCRYPTION_KEY=your-32-byte-base64-key

## Phase 2 - admin dashboard access control (comma-separated emails)
ADMIN_EMAILS=you@example.com

## Phase 2 - free tier monthly discussion limit per user
FREE_MONTHLY_LIMIT=2
